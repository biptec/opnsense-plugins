<model>
    <mount>//OPNsense/ApiExtensions/CarpHealth</mount>
    <description>CARP L2 health monitoring</description>
    <version>1.4.0</version>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <interval type="IntegerField">
            <Default>1</Default>
            <MinimumValue>1</MinimumValue>
            <MaximumValue>60</MaximumValue>
            <Required>Y</Required>
        </interval>
        <failure_threshold type="IntegerField">
            <Default>2</Default>
            <MinimumValue>1</MinimumValue>
            <MaximumValue>20</MaximumValue>
            <Required>Y</Required>
        </failure_threshold>
        <recovery_threshold type="IntegerField">
            <Default>2</Default>
            <MinimumValue>1</MinimumValue>
            <MaximumValue>20</MaximumValue>
            <Required>Y</Required>
        </recovery_threshold>
        <checks>
            <check type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[0-9A-Za-z._-]{1,64}$/</Mask>
                    <ValidationMessage>Use 1-64 letters, numbers, dots, underscores or dashes.</ValidationMessage>
                    <Constraints>
                        <check001>
                            <type>UniqueConstraint</type>
                            <ValidationMessage>Health check names must be unique.</ValidationMessage>
                        </check001>
                    </Constraints>
                </name>
                <interface type="InterfaceField">
                    <Required>Y</Required>
                    <AllowDynamic>Y</AllowDynamic>
                    <filters>
                        <enable>/^(?!0).*$/</enable>
                    </filters>
                </interface>
                <target type="NetworkField">
                    <Required>Y</Required>
                    <AddressFamily>ipv4</AddressFamily>
                    <NetMaskAllowed>N</NetMaskAllowed>
                    <ValidationMessage>Specify an IPv4 address reachable on this L2 segment.</ValidationMessage>
                </target>
                <scope type="OptionField">
                    <Default>interface</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <interface>Automatic: CARP on probe interface</interface>
                        <all_carp>Automatic: all configured CARP</all_carp>
                        <vhid>Explicit: specific VHID</vhid>
                        <vhid_group>Explicit: VHID target group</vhid_group>
                        <global>Legacy: global CARP demotion</global>
                    </OptionValues>
                </scope>
                <vhid type="IntegerField">
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>255</MaximumValue>
                    <Required>Y</Required>
                </vhid>
                <failure_advskew type="IntegerField">
                    <Default>254</Default>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>254</MaximumValue>
                    <Required>Y</Required>
                </failure_advskew>
                <vhid_targets type="CSVListField">
                    <Required>N</Required>
                    <Mask>/^[0-9A-Za-z._-]+:(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$/</Mask>
                    <MaskPerItem>Y</MaskPerItem>
                    <ValidationMessage>Use logical-interface:VHID entries with VHID between 1 and 255.</ValidationMessage>
                </vhid_targets>
                <fallback_ipv4_target type="NetworkField">
                    <Required>N</Required><AddressFamily>ipv4</AddressFamily><NetMaskAllowed>N</NetMaskAllowed>
                </fallback_ipv4_target>
                <fallback_ipv4_gateway type="NetworkField">
                    <Required>N</Required><AddressFamily>ipv4</AddressFamily><NetMaskAllowed>N</NetMaskAllowed>
                </fallback_ipv4_gateway>
                <fallback_ipv6_target type="NetworkField">
                    <Required>N</Required><AddressFamily>ipv6</AddressFamily><NetMaskAllowed>N</NetMaskAllowed>
                </fallback_ipv6_target>
                <fallback_ipv6_gateway type="NetworkField">
                    <Required>N</Required><AddressFamily>ipv6</AddressFamily><NetMaskAllowed>N</NetMaskAllowed>
                </fallback_ipv6_gateway>
                <fallback_ipv4_default_gateway type="NetworkField">
                    <Required>N</Required><AddressFamily>ipv4</AddressFamily><NetMaskAllowed>N</NetMaskAllowed>
                </fallback_ipv4_default_gateway>
                <fallback_ipv6_default_gateway type="NetworkField">
                    <Required>N</Required><AddressFamily>ipv6</AddressFamily><NetMaskAllowed>N</NetMaskAllowed>
                </fallback_ipv6_default_gateway>
                <backup_ipv4_default_gateway type="NetworkField">
                    <Required>N</Required><AddressFamily>ipv4</AddressFamily><NetMaskAllowed>N</NetMaskAllowed>
                </backup_ipv4_default_gateway>
                <backup_ipv6_default_gateway type="NetworkField">
                    <Required>N</Required><AddressFamily>ipv6</AddressFamily><NetMaskAllowed>N</NetMaskAllowed>
                </backup_ipv6_default_gateway>
            </check>
        </checks>
    </items>
</model>
