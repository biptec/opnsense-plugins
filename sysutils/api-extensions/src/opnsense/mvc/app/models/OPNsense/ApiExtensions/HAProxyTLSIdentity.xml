<model>
    <mount>//OPNsense/ApiExtensions/HAProxyTLSIdentity</mount>
    <description>Node-local HAProxy TLS identity registrations</description>
    <version>1.0.0</version>
    <items>
        <sync_marker>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
        </sync_marker>
        <identities>
            <identity type="ArrayField">
                <frontend_name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^([0-9a-zA-Z._\-]){1,255}$/u</Mask>
                    <ValidationMessage>Use the exact HAProxy frontend semantic name.</ValidationMessage>
                </frontend_name>
                <dns_name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9\-]{0,61}[A-Za-z0-9])?\.)*[A-Za-z0-9](?:[A-Za-z0-9\-]{0,61}[A-Za-z0-9])?$/u</Mask>
                    <ValidationMessage>Use a valid DNS hostname.</ValidationMessage>
                </dns_name>
                <policy_id type="ModelRelationField">
                    <Required>Y</Required>
                    <Model>
                        <template>
                            <source>OPNsense.ApiExtensions.HASyncPolicy</source>
                            <items>shared.policies.policy</items>
                            <display>id</display>
                        </template>
                    </Model>
                    <ValidationMessage>Select an existing HA sync policy.</ValidationMessage>
                </policy_id>
            </identity>
        </identities>
    </items>
</model>
